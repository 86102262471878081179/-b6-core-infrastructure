# ═══════════════════════════════════════════════════════════════════════════════
# B6-CORE RUST WORM KERNEL — Monster Edition Dockerfile
# ═══════════════════════════════════════════════════════════════════════════════

# ── Stage 1: Builder ────────────────────────────────────────────────────────
FROM rust:1.83-alpine AS builder

RUN apk add --no-cache musl-dev gcc pkgconfig openssl-dev

WORKDIR /usr/src/rust_kernel

# Dependencies-Cache-Layer (beschleunigt Rebuilds)
COPY Cargo.toml Cargo.lock* ./
RUN mkdir src && echo "fn main() {}" > src/main.rs && \
    cargo build --release && \
    rm -rf src

# Source-Code
COPY src ./src
RUN touch src/main.rs && cargo build --release

# ── Stage 2: Runtime ────────────────────────────────────────────────────────
FROM alpine:3.20

RUN apk add --no-cache ca-certificates libgcc netcat-openbsd curl

WORKDIR /app
COPY --from=builder /usr/src/rust_kernel/target/release/rust_kernel /app/rust_kernel

# WORM-Vault-Verzeichnis
RUN mkdir -p /var/lib/worm_vault
VOLUME ["/var/lib/worm_vault"]

EXPOSE 8080
ENV RUST_LOG=info

# Healthcheck
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

CMD ["/app/rust_kernel"]
